<?xml version="1.0" encoding="UTF-8"?>

<Defs>

   <FactionDef ParentName="FactionBase">
        <defName>Faction_Iconoclast</defName>
        <label>Iconoclast Faction</label>
        <description>The Iconoclasts are a group of survivalists living in the ruins of Amber Heights on Monarch. They hope to one day tear down the Halcyon Holdings Corporate Board that they believe has brought the colony to the brink of death.</description>
        <colorSpectrum>
            <li>(1, 1, 1)</li>
        </colorSpectrum>
        <fixedLeaderKinds>
			<li>Iconoclast_Leader</li>
		</fixedLeaderKinds>
        <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
        <pawnSingular>Iconoclast</pawnSingular>
        <pawnsPlural>Iconoclasts</pawnsPlural>
        <categoryTag>Offworld</categoryTag>
        <settlementGenerationWeight>1</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <naturalEnemy>false</naturalEnemy>
        <canSiege>true</canSiege>
        <canStageAttacks>true</canStageAttacks>
        <leaderTitle>Leader</leaderTitle>
        <factionIconPath>UI/IconoclastIcon</factionIconPath>
        <techLevel>Spacer</techLevel> 
        <fixedName>Iconoclasts</fixedName>
        <settlementNameMaker>NamerSettlementEmpire</settlementNameMaker>
        <allowedCultures>
            <li>Astropolitan</li>
        </allowedCultures>

        <!--__________ Ideology __________-->

        <!--<fixedIdeo>true</fixedIdeo>
        <ideoName>URMC Militarism</ideoName>
        <ideoDescription>PLACEHOLDER</ideoDescription>
        <forcedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Ideological</li>

        </forcedMemes>
        <requiredPreceptsOnly>true</requiredPreceptsOnly>-->

        <!--__________ Biotech __________-->

        <xenotypeSet>
            <xenotypeChances>
                <Neanderthal MayRequire="Ludeon.RimWorld.Biotech">0</Neanderthal>
                <Hussar MayRequire="Ludeon.RimWorld.Biotech">0</Hussar>
                <Pigskin MayRequire="Ludeon.RimWorld.Biotech">0</Pigskin>
                <Yttakin MayRequire="Ludeon.RimWorld.Biotech">0</Yttakin>
                <Genie MayRequire="Ludeon.RimWorld.Biotech">0</Genie>
                <Dirtmole MayRequire="Ludeon.RimWorld.Biotech">0</Dirtmole>
                <Highmate MayRequire="Ludeon.RimWorld.Biotech">0</Highmate>
                <Impid MayRequire="Ludeon.RimWorld.Biotech">0</Impid>
                <Sanguophage MayRequire="Ludeon.RimWorld.Biotech">0</Sanguophage>
                <Baseliner MayRequire="Ludeon.RimWorld.Biotech">1</Baseliner>
            </xenotypeChances>
        </xenotypeSet>

        <!--__________ Backstories __________-->
        
        <backstoryFilters>
            <li>
                <categoriesChildhood>
                    <li>Offworld</li>
                  </categoriesChildhood>
                <categoriesAdulthood>
                    <li>Offworld</li>
                </categoriesAdulthood>
                <commonality>1</commonality>
            </li>
        </backstoryFilters>

        <!--__________ Kinds __________-->

        <!-- Caravan Trader Kinds -->
        
        <caravanTraderKinds>
           <li>Caravan_Outlander_BulkGoods</li>
      <li>Caravan_Outlander_CombatSupplier</li>
        </caravanTraderKinds>

        <!-- Vistor Trader Kinds -->
        
        <visitorTraderKinds>
            <li>Visitor_Outlander_Standard</li>
        </visitorTraderKinds>

        <!-- Base Trader Kinds -->
        
        <baseTraderKinds>
            <li>Base_Outlander_Standard</li>
        </baseTraderKinds>

        <!-- Trader Kind Arrival Options -->
        
        <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
        <raidLootMaker>Iconoclasts_RaidLootMaker</raidLootMaker>
        <maxPawnCostPerTotalPointsCurve>
            <points>
                <li>(0,35)</li>
                <li>(70, 50)</li>
                <li>(700, 100)</li>
                <li>(1300, 150)</li>
                <li>(100000, 10000)</li>
            </points>
        </maxPawnCostPerTotalPointsCurve>

        <!--__________ Group Makers __________-->
        
        <pawnGroupMakers>

            <li>
                <kindDef>Combat</kindDef>
                <disallowedStrategies>
                    <li>EmergeFromWater</li>
                </disallowedStrategies>
                <options>
                    <Iconoclast_Agitator>8</Iconoclast_Agitator>
                    <Iconoclast_Rioter>14</Iconoclast_Rioter>
                    <Iconoclast_Revolutionary>2</Iconoclast_Revolutionary>
                    <Iconoclast_Leader>1</Iconoclast_Leader>
                </options>
            </li>

            <!--__________ URMC Traders __________-->

            <!-- URMC Caravan -->

            <li>
                <kindDef>Trader</kindDef>
                <traders>
                    <Iconoclast_Trader>1</Iconoclast_Trader>
                </traders>
                <carriers>
                    <Alpaca>2</Alpaca>
                </carriers>
                <guards>
                    <Iconoclast_Agitator>6</Iconoclast_Agitator>
                    <Iconoclast_Rioter>5</Iconoclast_Rioter>
                    <Iconoclast_Revolutionary>3</Iconoclast_Revolutionary>
                    <Iconoclast_Leader>1</Iconoclast_Leader>
                </guards>
            </li>

            <!-- URMC Settlement -->

            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <Iconoclast_Agitator>8</Iconoclast_Agitator>
                    <Iconoclast_Rioter>14</Iconoclast_Rioter>
                    <Iconoclast_Revolutionary>2</Iconoclast_Revolutionary>
                    <Iconoclast_Leader>1</Iconoclast_Leader>
                </options>
            </li>
        </pawnGroupMakers>
        <settlementTexturePath>UI/IconoclastIcon</settlementTexturePath>

    </FactionDef>

    <ThingSetMakerDef>
        <defName>Iconoclasts_RaidLootMaker</defName>
        <root Class="ThingSetMaker_MarketValue">
            <fixedParams>
                <filter>
                    <thingDefs>
                        <li>Silver</li>
                        <li>MedicineIndustrial</li>
                        <li>ComponentIndustrial</li>
                        <li>MealSurvivalPack</li>
                        <li>Neutroamine</li>
                    </thingDefs>
                </filter>
            </fixedParams>
        </root>
    </ThingSetMakerDef>


</Defs>