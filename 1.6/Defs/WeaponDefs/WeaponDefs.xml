<!--__Iconoclast Cleaver__-->

<ThingDef ParentName="BaseMeleeWeapon_Blunt_Quality">
    <defName>MeleeWeapon_IconoclastCleaver</defName>
    <label>Iconoclast Cleaver</label>
    <description>“A 2-handed weapon with a vibrating blade. The blade can be modified to deal different types of damage. Those Iconoclasts really know their cleaving!”</description>
    <techLevel>Industrial</techLevel>
    <costStuffCount>160</costStuffCount>
    <thingSetMakerTags><li>RewardStandardQualitySuper</li></thingSetMakerTags>
    <graphicData>
      <texPath>Weapons/IcoHammer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <statBases>
      <WorkToMake>18000</WorkToMake>
      <Mass>5</Mass>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>LongBlades</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <displayPriority>440</displayPriority>
    </recipeMaker>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
    </stuffCategories>
    <weaponTags>
      <li>MedievalMeleeDecent</li>
    </weaponTags>
    <weaponClasses>
      <li>Melee</li>
    </weaponClasses>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>13</power>
        <cooldownTime>2.6</cooldownTime>
      </li>
      <li>
        <label>head</label>
        <labelUsedInLogging>false</labelUsedInLogging>
